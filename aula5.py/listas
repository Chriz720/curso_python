#podemos criar uma lista vazia e ir adicionando elementos a ela com o append().
lista = []

while True:
    item = input("Digite um item para adicionar à lista (ou 'sair' para encerrar): ")
    
    if item.lower() == "sair":
        break
    
    lista.append(item)

if len(lista) > 0:
    for item in lista:
        print(item)
else:   
    print("A lista está vazia.")

